# Required: Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Django settings (auto-generated if not provided)
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

