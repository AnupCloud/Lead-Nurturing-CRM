```typescript
'use client';

import { useState, useEffect } from 'react';
import Sidebar from '../../components/Sidebar';
import { MessageCircle, ExternalLink, X } from 'lucide-react';

interface Campaign {
    id: number;
    name: string;
}

interface Conversation {
    id: number;
    lead_name: string;
    lead_id: number;
    speaker: string;
    message: string;
    timestamp: string;
}

export default function FollowupsPage() {
    const [campaigns, setCampaigns] = useState<Campaign[]>([]);
    const [selectedCampaignId, setSelectedCampaignId] = useState<number | null>(null);
    const [conversations, setConversations] = useState<Conversation[]>([]);
    const [showConversationModal, setShowConversationModal] = useState(false);
    const [selectedLeadConversations, setSelectedLeadConversations] = useState<Conversation[]>([]);
    const [selectedLeadName, setSelectedLeadName] = useState('');

    useEffect(() => {
        fetchCampaigns();
    }, []);

    useEffect(() => {
        if (campaigns.length > 0 && !selectedCampaignId) {
            fetchConversations(campaigns[0].id);
        }
    }, [campaigns]);

    const fetchCampaigns = async () => {
        try {
            const res = await fetch('http://localhost:8000/api/campaigns/list');
            if (res.ok) {
                const data = await res.json();
                setCampaigns(data.campaigns || []);
            }
        } catch (error) {
            console.error('Error fetching campaigns:', error);
        }
    };

    const fetchConversations = async (campaignId: number) => {
        setSelectedCampaignId(campaignId);
        try {
            const res = await fetch(`http://localhost:8000/api/campaigns/${campaignId}/conversations`);
if (res.ok) {
    const data = await res.json();
    setConversations(data.conversations || []);
}
        } catch (error) {
    console.error('Error fetching conversations:', error);
}
    };

// Group conversations by lead
const getUniqueLeads = () => {
    const leadMap = new Map<number, { name: string; lastMessage: string; timestamp: string; status: string }>();
    conversations.forEach(conv => {
        if (!leadMap.has(conv.lead_id) || new Date(conv.timestamp) > new Date(leadMap.get(conv.lead_id)!.timestamp)) {
            const status = conv.message.toLowerCase().includes('property visit') || conv.message.toLowerCase().includes('viewing')
                ? 'Goal Achieved'
                : conv.speaker === 'Lead'
                    ? 'Active'
                    : 'Active';

            leadMap.set(conv.lead_id, {
                name: conv.lead_name,
                lastMessage: conv.message.substring(0, 80) + (conv.message.length > 80 ? '...' : ''),
                timestamp: conv.timestamp,
                status
            });
        }
    });
    return Array.from(leadMap.entries());
};

const viewLeadConversation = (leadId: number, leadName: string) => {
    const leadConvs = conversations
        .filter(c => c.lead_id === leadId)
        .sort((a, b) => new Date(a.timestamp).getTime() - new Date(b.timestamp).getTime());
    setSelectedLeadConversations(leadConvs);
    setSelectedLeadName(leadName);
    setShowConversationModal(true);
};

const uniqueLeads = getUniqueLeads();

return (
    <div className="flex h-screen bg-gray-50">
        <Sidebar />
        <main className="flex-1 overflow-y-auto">
            <div className="p-8">
                {/* Header */}
                <div className="mb-8">
                    <h1 className="text-2xl font-bold text-gray-800 mb-1">AI Agent Follow-ups</h1>
                    <p className="text-gray-500">Monitor AI-driven conversations and lead engagement</p>
                </div>

                {/* Campaign Selector */}
                {campaigns.length > 0 && (
                    <div className="mb-6">
                        <select
                            value={selectedCampaignId || ''}
                            onChange={(e) => fetchConversations(Number(e.target.value))}
                            className="border border-gray-300 rounded-lg px-4 py-2 text-sm text-gray-900 bg-white"
                        >
                            {campaigns.map((camp) => (
                                <option key={camp.id} value={camp.id}>{camp.name}</option>
                            ))}
                        </select>
                    </div>
                )}

                {/* Conversations List */}
                <div className="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
                    {uniqueLeads.length === 0 ? (
                        <div className="p-12 text-center text-gray-500">
                            <MessageCircle size={48} className="mx-auto mb-4 text-gray-300" />
                            <p>No conversations yet</p>
                            <p className="text-sm text-gray-400 mt-1">Start a campaign to begin nurturing leads</p>
                        </div>
                    ) : (
                        <div className="divide-y divide-gray-100">
                            {uniqueLeads.map(([leadId, lead]) => {
                                // Generate avatar color based on lead name
                                const getAvatarColor = (name: string) => {
                                    const colors = [
                                        'bg-blue-500',
                                        'bg-purple-500',
                                        'bg-pink-500',
                                        'bg-green-500',
                                        'bg-indigo-500',
                                        'bg-red-500',
                                        'bg-yellow-500',
                                        'bg-teal-500'
                                    ];
                                    const index = name.charCodeAt(0) % colors.length;
                                    return colors[index];
                                };

                                // Format timestamp as relative time
                                const getRelativeTime = (timestamp: string) => {
                                    const now = new Date();
                                    const then = new Date(timestamp);
                                    const seconds = Math.floor((now.getTime() - then.getTime()) / 1000);

                                    if (seconds < 60) return 'Just now';
                                    if (seconds < 3600) return `${Math.floor(seconds / 60)}m ago`;
                                    if (seconds < 86400) return `${Math.floor(seconds / 3600)}h ago`;
                                    if (seconds < 604800) return `${Math.floor(seconds / 86400)}d ago`;
                                    return then.toLocaleDateString();
                                };

                                return (
                                    <div
                                        key={leadId}
                                        onClick={() => viewLeadConversation(leadId, lead.name)}
                                        className="p-5 hover:bg-gray-50 cursor-pointer transition-colors duration-150"
                                    >
                                        <div className="flex items-center justify-between">
                                            <div className="flex items-center space-x-4 flex-1 min-w-0">
                                                {/* Avatar Bubble */}
                                                <div className={`w-12 h-12 ${getAvatarColor(lead.name)} rounded-full flex items-center justify-center flex-shrink-0`}>
                                                    <span className="text-white font-semibold text-lg">
                                                        {lead.name.charAt(0).toUpperCase()}
                                                    </span>
                                                </div>

                                                {/* Lead Info */}
                                                <div className="flex-1 min-w-0">
                                                    <div className="flex items-center space-x-2">
                                                        <h3 className="font-semibold text-gray-900 text-base">
                                                            {lead.name}
                                                        </h3>
                                                        <span className={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium flex-shrink-0 ${lead.status === 'Goal Achieved'
                                                            ? 'bg-green-100 text-green-800'
                                                            : lead.status === 'Paused'
                                                                ? 'bg-yellow-100 text-yellow-800'
                                                                : 'bg-blue-100 text-blue-800'
                                                            }`}>
                                                            {lead.status}
                                                        </span>
                                                    </div>
                                                    <p className="text-sm text-gray-600 mt-1 truncate">
                                                        {lead.lastMessage}
                                                    </p>
                                                </div>
                                            </div>

                                            {/* Timestamp & Arrow */}
                                            <div className="flex items-center space-x-3 flex-shrink-0 ml-4">
                                                <span className="text-xs text-gray-400">
                                                    {getRelativeTime(lead.timestamp)}
                                                </span>
                                                <ExternalLink size={18} className="text-gray-400" />
                                            </div>
                                        </div>
                                    </div>
                                );
                            })}
                        </div>
                    )}
                </div>
            </div>
        </main>

        {/* Conversation Modal */}
        {showConversationModal && (
            <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
                <div className="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[80vh] flex flex-col">
                    {/* Modal Header */}
                    <div className="p-6 border-b border-gray-200 flex justify-between items-center">
                        <h2 className="text-xl font-semibold text-gray-800">Conversation with {selectedLeadName}</h2>
                        <button
                            onClick={() => setShowConversationModal(false)}
                            className="text-gray-400 hover:text-gray-600"
                        >
                            <X size={24} />
                        </button>
                    </div>

                    {/* Conversation Content */}
                    <div className="flex-1 overflow-y-auto p-6 space-y-4">
                        {selectedLeadConversations.map((conv) => (
                            <div key={conv.id} className={`flex ${conv.speaker === 'agent' ? 'justify-end' : 'justify-start'}`}>
                                <div className={`max-w-[75%] rounded-2xl px-4 py-3 ${conv.speaker === 'agent'
                                    ? 'bg-blue-600 text-white'
                                    : 'bg-gray-100 text-gray-900'
                                    }`}>
                                    <div className="flex items-center space-x-2 mb-1">
                                        <span className={`text-xs font-medium ${conv.speaker === 'agent' ? 'text-blue-100' : 'text-gray-500'}`}>
                                            {conv.speaker === 'agent' ? '🤖 AI Agent' : `👤 ${conv.lead_name}`}
                                        </span>
                                    </div>
                                    <p className="text-sm">{conv.message}</p>
                                    <p className={`text-xs mt-1 ${conv.speaker === 'agent' ? 'text-blue-200' : 'text-gray-500'}`}>
                                        {new Date(conv.timestamp).toLocaleString()}
                                    </p>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* Modal Footer */}
                    <div className="p-6 border-t border-gray-200 flex justify-end space-x-3">
                        <button
                            onClick={() => setShowConversationModal(false)}
                            className="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300"
                        >
                            Close
                        </button>
                    </div>
                </div>
            </div>
        )}
    </div>
);
}
